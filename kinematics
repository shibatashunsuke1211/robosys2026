import sys
import math

for line in sys.stdin:
    try:
        values = list(map(float, line.split()))

        if not all(math.isfinite(v) for v in values):
            raise ValueError

        if len(values) == 7:
            values.insert(4, 0)

        L1, L2, L3, L4, θ1, θ2, θ3, θ4 = values

    except ValueError:
        print("7 or 8 numbers are required.", file=sys.stderr)
        sys.exit(1)

    θ1 = math.radians(θ1)
    θ2 = math.radians(θ2)
    θ3 = math.radians(θ3)
    θ4 = math.radians(θ4)

    x = L2*math.cos(θ1+θ2) + L3*math.cos(θ1+θ2+θ3) + L4*math.cos(θ1+θ2+θ3+θ4)
    y = L2*math.sin(θ1+θ2) + L3*math.sin(θ1+θ2+θ3) + L4*math.sin(θ1+θ2+θ3+θ4)
    z = L1
    α = math.degrees(θ1+θ2+θ3+θ4)

    print(f"{x:.2f} {y:.2f} {z:.2f} {α:.2f}")



