import sys
import math

for line in sys.stdin:
    try:
        L1, L2, L3, L4, θ2, θ3, θ4 = map(float, line.split())
    except ValueError:
        print("7 numbers are required.", file=sys.stderr)
        sys.exit(1)

    θ2 = math.radians(θ2)
    θ3 = math.radians(θ3)
    θ4 = math.radians(θ4)

    x = L2*math.cos(θ2) + L3*math.cos(θ2+θ3) + L4*math.cos(θ2+θ3+θ4)
    y = L2*math.sin(θ2) + L3*math.sin(θ2+θ3) + L4*math.sin(θ2+θ3+θ4)
    z = L1
    a = math.degrees(θ2+θ3+θ4)

    print(f"{x:.2f} {y:.2f} {z:.2f} {a:.2f}")
